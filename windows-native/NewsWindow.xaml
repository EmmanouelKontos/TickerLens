<local:AcrylicWindow x:Class="TickerLens.Native.NewsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TickerLens.Native"
    Title="TickerLens News" Width="410" Height="520" MinWidth="350" MinHeight="320"
    Left="500" Top="70">
    <Border CornerRadius="22" Background="#2413161F" BorderBrush="#50FFFFFF" BorderThickness="1">
      <Border CornerRadius="21" BorderBrush="#13000000" BorderThickness="1" Margin="1">
        <Grid Margin="12,10,12,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="DragHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TickerLens News" Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="8,0"
                           Foreground="{StaticResource TextMuted}" FontSize="10"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource GlassButton}"
                        ToolTip="Refresh news" Click="RefreshClick">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="#16FFFFFF"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,2">
                <ItemsControl x:Name="NewsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="10" Padding="4,7,7,7"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="HeadlineClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AccentBar" CornerRadius="2" Background="#8F949F"/>
                                    <StackPanel Grid.Column="1" Margin="9,0,9,0">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,0">
                                            <Run Text="{Binding Publisher}"/><Run Text="  ·  "/>
                                            <Run Text="{Binding Time}"/><Run Text="  ·  "/><Run Text="{Binding Symbols}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border x:Name="Badge" Grid.Column="2" CornerRadius="5"
                                            Background="#238F949F" BorderBrush="#668F949F"
                                            BorderThickness="1" Padding="6,2" VerticalAlignment="Top">
                                        <TextBlock x:Name="BadgeText" Text="{Binding Sentiment}"
                                                   Foreground="#B8BDC8" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Good}" Value="True">
                                    <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource Positive}"/>
                                    <Setter TargetName="Badge" Property="Background" Value="#2442D77D"/>
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="#8242D77D"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Positive}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bad}" Value="True">
                                    <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource Negative}"/>
                                    <Setter TargetName="Badge" Property="Background" Value="#24FF5A61"/>
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="#82FF5A61"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Negative}"/>
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#14FFFFFF"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="3" Text="Yahoo Finance · free · synced watchlist"
                       Foreground="{StaticResource TextMuted}" FontSize="9" Opacity=".75"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>
    </Border>
</local:AcrylicWindow>
