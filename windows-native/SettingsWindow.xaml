<Window x:Class="TickerLens.Native.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TickerLens settings" Width="430" Height="285"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
    Background="#FF20232B" Foreground="#FFF3F4F7">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Watchlist symbols" FontSize="13" FontWeight="SemiBold"/>
        <TextBox x:Name="SymbolsBox" Grid.Row="1" Margin="0,7,0,14" Padding="8,6"
                 Background="#18FFFFFF" Foreground="#FFF3F4F7" BorderBrush="#35FFFFFF"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Refresh every" VerticalAlignment="Center"/>
            <TextBox x:Name="RefreshBox" Width="46" Margin="8,0" Padding="5,3"
                     Background="#18FFFFFF" Foreground="#FFF3F4F7" BorderBrush="#35FFFFFF"/>
            <TextBlock Text="minutes" VerticalAlignment="Center"/>
            <CheckBox x:Name="TopmostBox" Content="Always on top" Margin="24,0,0,0"
                      VerticalAlignment="Center" Foreground="#FFF3F4F7"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="#FF9DA3B2" FontSize="10"
                   Text="Separate symbols with commas. Changes apply to both Markets and News."/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="78" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="78" IsDefault="True" Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>
